{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mppt24:schema:report:2.1.0",
  "title": "MPPT24 CORE Serialized Report",
  "description": "Contrato estrutural do relatório serializado 2.1.0.",
  "type": "object",
  "$defs": {
    "normalizedName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+([0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*))?$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "OK",
        "WARNING",
        "ERROR",
        "UNKNOWN"
      ]
    },
    "textArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "properties": {
    "module": {
      "$ref": "#/$defs/normalizedName"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "timestamp": {
      "$ref": "#/$defs/timestamp"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "facts": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": true
    },
    "health": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/normalizedName"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/$defs/status"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": true
      }
    },
    "analysis": {
      "$ref": "#/$defs/textArray"
    },
    "conclusions": {
      "$ref": "#/$defs/textArray"
    },
    "summary": {
      "$ref": "#/$defs/textArray"
    },
    "recommendations": {
      "$ref": "#/$defs/textArray"
    },
    "warnings": {
      "$ref": "#/$defs/textArray"
    },
    "errors": {
      "$ref": "#/$defs/textArray"
    }
  },
  "required": [
    "module",
    "version",
    "timestamp",
    "status",
    "confidence",
    "facts",
    "analysis",
    "conclusions",
    "health",
    "summary",
    "recommendations",
    "warnings",
    "errors"
  ],
  "additionalProperties": false
}
